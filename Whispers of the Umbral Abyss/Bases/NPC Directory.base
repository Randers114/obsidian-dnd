filters:
  and:
    - file.ext == "md"
    - type == "person"
properties:
  file.name:
    displayName: Name
  organization:
    displayName: Organization
  location:
    displayName: Location
  status:
    displayName: Status
  note.organization:
    displayName: organizations
views:
  - type: table
    name: NPCs
    order:
      - file.name
      - status
      - locations
      - organizations
      - tags
    sort:
      - property: organization
        direction: DESC
